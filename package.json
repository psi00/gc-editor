{
  "name": "gc-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "local/offline CS:GO + CS2 inventory editor for gt-610 csgo_gc - live rcon + inventory.txt",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/psi00/gc-editor.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node server/index.js & vite --config vite.config.ts",
    "dev:server": "node server/index.js",
    "dev:web": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts",
    "test": "node --test test/inventory.test.js test/custom-css.test.js",
    "lint:commits": "commitlint --from HEAD~1 --to HEAD --verbose",
    "start": "node server/index.js",
    "prepare": "husky",
    "fetch-schema": "node scripts/fetch-schema.mjs",
    "filter-schema": "node scripts/filter-schema.mjs",
    "build-cases": "node scripts/build-cases.mjs",
    "build-favicon": "node scripts/build-favicon.mjs",
    "prefetch-images": "node scripts/prefetch-images.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.2",
    "husky": "^9.1.7",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
